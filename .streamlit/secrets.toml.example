# Streamlit Secrets Template
# Copy this file to .streamlit/secrets.toml (never commit that file)
# Fill in your actual values before deploying

# ─────────────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ─────────────────────────────────────────────────────
# Leave DATABASE_URL empty or unset to use local SQLite.
# The database file will be created at database/attendance.db

# ─────────────────────────────────────────────────────
# CLOUD DEPLOYMENT (Supabase / PostgreSQL)
# ─────────────────────────────────────────────────────
# Uncomment and fill in your Supabase connection string:

# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

# How to get this value:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings → Database
# 3. Copy the "Connection string (URI)" under Connection Info
# 4. Replace [YOUR-PASSWORD] with your actual DB password
